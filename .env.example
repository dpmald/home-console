# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon key is only used by the kiosk to subscribe to the "kitchen" broadcast
# channel (change pings only — no family data is readable with it; RLS is on).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Family / locale ────────────────────────────────────────
NEXT_PUBLIC_FAMILY_TIMEZONE=America/New_York
# Secret address in iCal format from Google Calendar Settings → Family → Integrate calendar
# (optionally prefix with "family_google|https://..." or comma-separate multiple calendars)
GOOGLE_CALENDAR_ICS_URLS=
WEATHER_LAT=38.9072
WEATHER_LON=-77.0369
# Replace with your local member station's stream URL
NEXT_PUBLIC_NPR_STREAM_URL=https://npr-ice.streamguys1.com/live.mp3

# ── Kiosk access ───────────────────────────────────────────
# Open https://your-app.vercel.app/?key=THIS_VALUE once on the Cozyla
# (and your phones/laptops); a 1-year cookie is set.
KIOSK_ACCESS_TOKEN=change-me-to-a-long-random-string

# Optional separate beta deployment. HTTPS URL only; no key, query or fragment.
# The family kitchen links to the hosted Beta by default. Use off to hide the link.
HOME_CONSOLE_BETA_URL=
# Optional family production voice forwarding. Use the hosted Beta device key.
# This server-only credential is sent only to the family's fixed hosted grocery endpoint.
HOME_CONSOLE_SHARED_GROCERY_DEVICE_KEY=

# ── Slack ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# Stable server only. Dotty's separate Slack app posts reaction events to /api/slack/dotty.
DOTTY_SIGNING_SECRET=
DOTTY_CHANNEL_ID=
DOTTY_APPROVER_ID=
DOTTY_BOT_USER_ID=
# Fine-grained credential restricted to this repository, Actions: write, for waking the review workflow.
DOTTY_REVIEW_DISPATCH_TOKEN=
SLACK_CHANNEL_LOGISTICS=#logistics
SLACK_CHANNEL_FOOD=#food
SLACK_CHANNEL_CHORES=#logistics
# Pickup nudges (bot must be invited here so it can read thread replies)
SLACK_CHANNEL_CALENDAR=#calendar
# Slack member IDs (Profile → ⋮ → Copy member ID) for @-mentions and
# so "Cook from backlog" knows who clicked.
SLACK_USER_DANIELA=U0000000000
SLACK_USER_WARREN=U0000000000

# ── Schedules (local hours, 24h) ───────────────────────────
STANDUP_HOUR=9
DINNER_NUDGE_HOUR=14
# Pickup nudge: first ping, follow-up ping, stop reading replies
PICKUP_NUDGE_HOUR=14
PICKUP_FOLLOWUP_HOUR=16
PICKUP_NUDGE_STOP_HOUR=19
GREENLIGHT_AUDIT_HOUR=18
# Mon | Tue | Wed | Thu | Fri | Sat | Sun — the day BEFORE Greenlight pays out
GREENLIGHT_AUDIT_WEEKDAY=Fri

# ── Machine-to-machine secrets ─────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
# n8n → /api/logistics/sync
SYNC_API_KEY=
# Warren's recipe agent → /api/recipes/*
RECIPE_AGENT_API_KEY=
# Dedicated Home Console MCP credential. Never reuse the kiosk or recipe-proposal key.
HOME_CONSOLE_GROCERY_AGENT_KEY=
# Development launcher only: dedicated 127.0.0.1:55432 PostgreSQL, never a hosted URL.
HOME_CONSOLE_GROCERY_DEV_DATABASE_URL=
HOME_CONSOLE_GROCERY_DEVELOPMENT=
# Set only on the separately deployed beta app. Leave unset on the stable kitchen.
HOME_CONSOLE_BETA_DEPLOYMENT=
# Optional public viewing. Shared grocery writes still require the Beta KIOSK_ACCESS_TOKEN.
HOME_CONSOLE_BETA_DEVICE_ACCESS=
# Public stable-kitchen URL for Back to kitchen. HTTPS, no credentials/query/fragment.
HOME_CONSOLE_KITCHEN_URL=
# Hosted beta only: separate Supabase project/key. No fallback to stable credentials.
HOME_CONSOLE_BETA_SUPABASE_URL=
HOME_CONSOLE_BETA_SUPABASE_SERVICE_ROLE_KEY=
# Calendar integration credentials are explicitly blanked in local previews.
GOOGLE_CALENDAR_ICS_URLS=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_FAMILY_CALENDAR_ID=
# Optional: we POST the decision here when a cart is approved / held.
RECIPE_AGENT_CALLBACK_URL=

# ── Gemini (Dinner Hub tips & recommendations) ─────────────
# Create a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Voice (OpenAI Realtime over WebRTC) ────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# ── Spotify Connect (Option 1: controls background Spotify Android app on Cozyla) ──
# Create an app at https://developer.spotify.com/dashboard with redirect URI:
#   http://localhost:3000/api/spotify/auth  (and your Vercel URL)
# Then open /api/spotify/auth once in your browser to get SPOTIFY_REFRESH_TOKEN.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional substring match for the Cozyla's Spotify Connect device name
SPOTIFY_DEVICE_NAME=Kitchen

# Optional link from synthetic grocery previews to the hosted Beta kitchen.
HOME_CONSOLE_HOSTED_BETA_URL=
