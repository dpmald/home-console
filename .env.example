# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Anon key is only used by the kiosk to subscribe to the "kitchen" broadcast
# channel (change pings only — no family data is readable with it; RLS is on).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Family / locale ────────────────────────────────────────
NEXT_PUBLIC_FAMILY_TIMEZONE=America/New_York
WEATHER_LAT=38.9072
WEATHER_LON=-77.0369
# Replace with your local member station's stream URL
NEXT_PUBLIC_NPR_STREAM_URL=https://npr-ice.streamguys1.com/live.mp3

# ── Kiosk access ───────────────────────────────────────────
# Open https://your-app.vercel.app/?key=THIS_VALUE once on the Cozyla
# (and your phones/laptops); a 1-year cookie is set.
KIOSK_ACCESS_TOKEN=change-me-to-a-long-random-string

# ── Slack ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_LOGISTICS=#logistics
SLACK_CHANNEL_FOOD=#food
SLACK_CHANNEL_CHORES=#logistics
# Slack member IDs (Profile → ⋮ → Copy member ID) for @-mentions and
# so "Cook from backlog" knows who clicked.
SLACK_USER_DANIELA=U0000000000
SLACK_USER_WARREN=U0000000000

# ── Schedules (local hours, 24h) ───────────────────────────
STANDUP_HOUR=9
DINNER_NUDGE_HOUR=14
GREENLIGHT_AUDIT_HOUR=18
# Mon | Tue | Wed | Thu | Fri | Sat | Sun — the day BEFORE Greenlight pays out
GREENLIGHT_AUDIT_WEEKDAY=Fri

# ── Machine-to-machine secrets ─────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
# n8n → /api/logistics/sync
SYNC_API_KEY=
# Warren's recipe agent → /api/recipes/*
RECIPE_AGENT_API_KEY=
# Optional: we POST the decision here when a cart is approved / held.
RECIPE_AGENT_CALLBACK_URL=

# ── Voice (OpenAI Realtime over WebRTC) ────────────────────
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
